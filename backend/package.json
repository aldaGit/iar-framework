{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "NODE_ENV=development node ./src/app.js",
    "start_win": "set NODE_ENV=development&& node ./src/app.js",
    "start_production": "set NODE_ENV=production&& node ./src/app.js",
    "test:unit": "jest --config=./jest.config.js",
    "test:integration": "jest --config=./jest-integration.config.js --detectOpenHandles --forceExit",
    "dev:test:integration": "NODE_ENV=development npm run test:integration",
    "ci:test:integration": "NODE_ENV=ci npm run test:integration",
    "dev_win:test:integration": "set NODE_ENV=development&&npm run test:integration",
    "coverage:test:unit": "jest ./test/unit --config=./jest-coverage.config.js"
  },
  "type": "commonjs",
  "dependencies": {
    "cookie-session": "^2.1.1",
    "cors": "^2.8.6",
    "express": "~5.2.1",
    "mongodb": "^7.5.0",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "jest": "^30.5.1",
    "jest-junit": "^17.0.0",
    "mongo-mock": "^4.2.0",
    "supertest": "^7.2.2"
  }
}
